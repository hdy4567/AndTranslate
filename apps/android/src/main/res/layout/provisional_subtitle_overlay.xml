<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="220dp"
    android:layout_margin="16dp"
    android:background="@drawable/bg_subtitle_bar"
    android:padding="20dp">/*가로*/ <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp">

        <ImageButton
            android:id="@+id/btn_settings_provisional"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="Settings"
            app:tint="#B3FFFFFF" />

        <ImageButton
            android:id="@+id/btn_close_provisional"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close"
            app:tint="#B3FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_viitor_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Processing..."
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_provisional_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:textColor="#B3FFFFFF"
        android:textSize="20sp"
        android:textStyle="italic"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="6dp"
        android:paddingTop="8dp"
        android:shadowColor="#CC000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_viitor_status"
        tools:text="인식 중..." />

    <TextView
        android:id="@+id/tv_provisional_translated"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:textColor="#E6FFEB3B"
        android:textSize="18sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingExtra="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:shadowColor="#CC000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_provisional_subtitle"
        tools:text="번역 중..."
        tools:visibility="visible" />


    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/provisional_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        app:indicatorColor="#2196F3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_provisional_subtitle"
        app:trackColor="#26FFFFFF"
        app:trackThickness="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>