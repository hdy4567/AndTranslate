<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#121212"
    android:id="@+id/quiz_card_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_quiz_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="كلمة"
            android:textColor="#FF4081"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/tv_quiz_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Context Sentence..."
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="여기에 직접 써보세요"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- [HANDWRITING-CANVAS] -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.viitor.ui.tab3_words.HandwritingCanvasView
                android:id="@+id/quiz_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1AFFFFFF" />

            <!-- [CANVAS-TRASH] -->
            <ImageView
                android:id="@+id/btn_quiz_clear_canvas"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#66FFFFFF"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_quiz_meaning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="[ ??? ]"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#26FFFFFF"
                android:padding="12dp" />

            <Button
                android:id="@+id/btn_quiz_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="다음 단어 고!"
                android:backgroundTint="#FF4081"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:text="* 카드를 터치하면 정답이 나옵니다."
            android:textColor="#44FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>