<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/md_theme_dark_background"
    android:id="@+id/quiz_card_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- [WORD & TTS ROW] -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_quiz_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="単語"
                android:textColor="@color/md_theme_dark_secondary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_quiz_tts"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_action_volume_up"
                android:contentDescription="Listen Pronunciation"
                android:padding="6dp"
                app:tint="@color/md_theme_dark_secondary"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_quiz_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Context Sentence..."
            android:textColor="@color/text_medium_emphasis"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_stroke"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_canvas_hint"
            android:textColor="@color/text_low_emphasis"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- [HANDWRITING-CANVAS] -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.viitor.ui.tab3_words.HandwritingCanvasView
                android:id="@+id/quiz_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/glass_surface_bg" />

            <!-- [CANVAS-TRASH] -->
            <ImageView
                android:id="@+id/btn_quiz_clear_canvas"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:src="@drawable/ic_action_delete"
                android:contentDescription="Clear Canvas"
                app:tint="@color/text_low_emphasis"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>

        <!-- [MEANING & SKIP ROW] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_quiz_meaning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="[ ??? ]"
                android:textColor="@color/text_high_emphasis"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@color/glass_surface_bg"
                android:padding="12dp" />

            <Button
                android:id="@+id/btn_quiz_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/quiz_btn_next"
                android:backgroundTint="@color/md_theme_dark_secondary"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- [SRS GRADING BUTTONS (알아요 / 다시 보기)] -->
        <LinearLayout
            android:id="@+id/layout_quiz_grade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_quiz_retry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="다시 보기"
                android:backgroundTint="#C62828"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_quiz_know"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="알아요"
                android:backgroundTint="#2E7D32"
                android:textColor="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/quiz_touch_to_reveal"
            android:textColor="@color/text_disabled"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
