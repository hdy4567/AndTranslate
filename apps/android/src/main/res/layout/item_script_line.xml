<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/glass_stroke"
    app:cardBackgroundColor="@color/md_theme_dark_surface">

    <LinearLayout
        android:id="@+id/ll_sentence_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:padding="12dp">

        <!-- 반응형 액센트 인디케이터 바 -->
        <View
            android:id="@+id/v_item_bullet"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/md_theme_dark_outline"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/action_purple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- 일본어 형태소 칩 영역 -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flex_item_jp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap" />

            <!-- 한국어 번역 내용 -->
            <TextView
                android:id="@+id/tv_item_ko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_medium_emphasis"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="6dp" />

            <!-- 발음 레이어 -->
            <TextView
                android:id="@+id/tv_item_pronunciation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_low_emphasis"
                android:textSize="11sp"
                android:textStyle="italic"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
