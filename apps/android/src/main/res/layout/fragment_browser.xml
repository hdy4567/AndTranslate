<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 레이어 1: 유튜브를 구동하는 베이스 웹뷰 -->
    <WebView
        android:id="@+id/youtube_web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 레이어 2: 플로팅 서비스 토글 버튼 (AUTHORITATIVE SERVICE TRIGGER) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_overlay_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_translate"
        android:contentDescription="@string/app_name"
        app:tint="@color/white"
        app:backgroundTint="@color/md_theme_dark_secondary"
        app:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 레이어 3: 상단 좌측 A-B 루프 원터치 제어 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_browser_ab_loop"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:text="[A-B] 구간 반복"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:includeFontPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="#D91E1E1E"
        app:strokeColor="#55FFFFFF"
        app:strokeWidth="1dp"
        app:cornerRadius="18dp"
        app:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
