<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/glass_stroke"
    app:cardBackgroundColor="@color/md_theme_dark_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- [HEADER] Word & Main Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/ll_word_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/tv_word_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="単語"
                    android:textColor="@color/md_theme_dark_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_word_meaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/words_no_meaning"
                    android:textColor="@color/text_high_emphasis"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- [ACTIONS] Warp / Dict / Delete -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_warp_word"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_action_warp"
                    android:contentDescription="Warp to video"
                    app:tint="@color/action_blue"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/iv_dict_word"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_action_dict"
                    android:contentDescription="Open Dictionary"
                    app:tint="@color/action_yellow"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/iv_delete_word"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_action_delete"
                    android:contentDescription="Delete Word"
                    app:tint="@color/action_red"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </LinearLayout>

        <!-- [ACCORDION-TOGGLE] -->
        <LinearLayout
            android:id="@+id/ll_context_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/words_context_label"
                android:textColor="@color/text_low_emphasis"
                android:textSize="12sp"
                android:textStyle="italic" />

            <ImageView
                android:id="@+id/iv_context_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Expand context"
                app:tint="@color/text_low_emphasis" />
        </LinearLayout>

        <!-- [CONTEXT-BUBBLE] 말풍선 스타일 -->
        <LinearLayout
            android:id="@+id/container_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/glass_surface_bg"
            android:padding="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_word_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading context..."
                android:textColor="@color/text_medium_emphasis"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="@string/words_tap_to_warp"
                android:textColor="@color/action_blue"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
